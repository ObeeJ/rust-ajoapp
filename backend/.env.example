# Copy to backend/.env — never commit the real file.

# Required — generate with: openssl rand -hex 32
JWT_SECRET=

# Required — from your Paystack dashboard
PAYSTACK_SECRET_KEY=

# Required — Postgres connection string
DATABASE_URL=postgres://cowri:cowri@localhost:5432/cowri

# Required — exact frontend origin for CORS (no trailing slash)
CORS_ORIGIN=https://cowri.app

# Required — deployed frontend URL (used in Paystack callback)
APP_URL=https://cowri.app
