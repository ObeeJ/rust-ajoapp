# Copy to backend/.env — never commit the real file.

# ── Database ──────────────────────────────────────────────────────────────────
# Docker: postgres://cowri:cowri@db:5432/cowri
# Local:  postgres://cowri:cowri@localhost:5432/cowri
DATABASE_URL=postgres://cowri:cowri@db:5432/cowri

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker: redis://redis:6379
# Local:  redis://localhost:6379
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM=Cowri <noreply@cowri.app>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Cowri

# ── Admin bootstrap (one-time) ────────────────────────────────────────────────
# Generate: openssl rand -hex 16
ADMIN_BOOTSTRAP_SECRET=
